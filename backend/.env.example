# Load these through your hosting service or process environment. Do not commit real values.
PUBLIC_URL=https://your-ai-service.example
FRAMEFORGE_DATA_DIR=/data
# Obtain a registered identity OAuth client and exact callback URL from OpenAI.
OPENAI_CLIENT_ID=
OPENAI_TOKEN_AUTH_METHOD=none
OPENAI_CLIENT_SECRET=
# Content generation is charged to this server-side API account, separately from ChatGPT.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6.1-sol
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
DAILY_VIDEO_LIMIT=10
HOURLY_PLAN_LIMIT=30
GENERATION_WORKERS=2
